MEDIADROP_APP_NAME=MediaDrop
MEDIADROP_ENVIRONMENT=development
PORT=8000
# Replace this non-functional example before starting the backend in any environment.
MEDIADROP_API_TOKEN=change-me
MEDIADROP_ANALYSIS_PROVIDER=auto
MEDIADROP_ANALYSIS_TIMEOUT_SECONDS=30
MAX_FILE_SIZE=104857600
MAX_INPUT_BYTES=104857600
MAX_OUTPUT_BYTES=104857600
# Permite que coexistan streams de entrada y archivo final, sin aumentar el límite descargable.
MAX_TEMP_WORK_BYTES=230686720
DOWNLOAD_TIMEOUT=120
CONNECT_TIMEOUT=10
MAX_REDIRECTS=3
MEDIADROP_MAX_MEDIA_DURATION_SECONDS=600
MEDIADROP_MAX_URL_LENGTH=2048
# Predeterminado: mediadrop dentro del directorio temporal del sistema.
# MEDIADROP_TEMP_DIRECTORY=/tmp/mediadrop
TEMP_FILE_TTL=3600
MEDIADROP_TEMP_CLEANUP_INTERVAL_SECONDS=60
MAX_ACTIVE_JOBS=2
MAX_PROCESSING_JOBS=1
MEDIADROP_MEDIA_PROCESSING_TIMEOUT_SECONDS=300
MEDIADROP_FFMPEG_PATH=ffmpeg
MEDIADROP_FFPROBE_PATH=ffprobe
MEDIADROP_YOUTUBE_SOCKET_TIMEOUT_SECONDS=10
MEDIADROP_YOUTUBE_RETRIES=1
MEDIADROP_RATE_LIMIT_REQUESTS=180
MEDIADROP_RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=INFO
