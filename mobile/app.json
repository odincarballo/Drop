{
  "expo": {
    "name": "Drop",
    "slug": "mediadrop",
    "version": "1.8.1",
    "scheme": "mediadrop",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios"],
    "ios": {
      "buildNumber": "19",
      "supportsTablet": false,
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          }
        ]
      },
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Drop se conecta al backend de desarrollo en tu red local.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "plugins": [
      "expo-router",
      "expo-status-bar/app.plugin.js",
      "expo-sharing",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
