# Copia como .env.production y sustituye el dominio tras desplegar el backend.
# La configuración de producción rechaza HTTP, localhost y direcciones LAN.
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_API_URL=https://backend.example.com
EXPO_PUBLIC_API_TIMEOUT_MS=90000
EXPO_PUBLIC_JOB_POLL_INTERVAL_MS=750
